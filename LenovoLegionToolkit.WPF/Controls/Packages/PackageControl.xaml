<UserControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Packages.PackageControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">

    <custom:CardControl Margin="0,0,0,8">
        <custom:CardControl.Header>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Row 0: Status Pills + Category + Source -->
                <WrapPanel
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,12,6"
                    Orientation="Horizontal">

                    <Border
                        x:Name="_statusBadge"
                        Margin="0,0,8,0"
                        Padding="8,2"
                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                            <wpfui:SymbolIcon
                                x:Name="_statusIcon"
                                Margin="0,0,4,0"
                                FontSize="13"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Symbol="ArrowSync24" />
                            <TextBlock
                                x:Name="_statusTextBlock"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                Text="Update Available" />
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="_rebootBadge"
                        Margin="0,0,8,0"
                        Padding="8,2"
                        Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                        CornerRadius="4"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <wpfui:SymbolIcon
                                Margin="0,0,4,0"
                                FontSize="13"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Symbol="Warning24" />
                            <TextBlock
                                x:Name="_rebootTextBlock"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{x:Static resources:Resource.PackageControl_RebootRecommended}" />
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="_categorySourceTextBlock"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        MouseRightButtonUp="CopyToClipboard_MouseRightButtonUp" />
                </WrapPanel>

                <!-- Row 1: Title -->
                <TextBlock
                    x:Name="_titleTextBlock"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,0,12,4"
                    FontSize="14"
                    FontWeight="SemiBold"
                    MouseRightButtonUp="CopyToClipboard_MouseRightButtonUp"
                    TextTrimming="CharacterEllipsis" />

                <!-- Row 2: DriversCloud-style Version Comparison -->
                <StackPanel
                    x:Name="_versionComparisonPanel"
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,2,12,4"
                    Orientation="Horizontal">

                    <TextBlock
                        x:Name="_installedVersionLabel"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="_versionArrowText"
                        Margin="6,0,6,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="→"
                        Visibility="Collapsed" />

                    <TextBlock
                        x:Name="_availableVersionLabel"
                        FontSize="13"
                        FontWeight="Medium"
                        MouseRightButtonUp="CopyToClipboard_MouseRightButtonUp" />
                </StackPanel>

                <!-- Row 3: Description (optional) -->
                <TextBlock
                    x:Name="_descriptionTextBlock"
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="0,2,12,4"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    MouseRightButtonUp="CopyToClipboard_MouseRightButtonUp"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    MaxHeight="36" />

                <!-- Row 4: Date, Size, FileName -->
                <TextBlock
                    x:Name="_metaTextBlock"
                    Grid.Row="4"
                    Grid.Column="0"
                    Margin="0,2,12,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    MouseRightButtonUp="CopyToClipboard_MouseRightButtonUp"
                    TextTrimming="CharacterEllipsis" />

                <!-- Right Column: Clear Labeled Action Buttons -->
                <StackPanel
                    x:Name="_idleStackPanel"
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <wpfui:Button
                        x:Name="_readmeButton"
                        Margin="0,0,6,0"
                        Click="ReadmeButton_Click"
                        FontSize="16"
                        Icon="DocumentBulletList24"
                        ToolTip="{x:Static resources:Resource.PackageControl_OpenReadme}" />

                    <wpfui:Button
                        x:Name="_downloadButton"
                        Margin="0,0,6,0"
                        Click="DownloadButton_Click"
                        FontSize="16"
                        Icon="ArrowDownload24"
                        ToolTip="Download installer file only" />

                    <wpfui:Button
                        x:Name="_installButton"
                        MinWidth="110"
                        Appearance="Primary"
                        Click="InstallButton_Click"
                        Content="Update"
                        Icon="Play24"
                        ToolTip="Download and install automatically" />

                </StackPanel>

                <StackPanel
                    x:Name="_downloadingStackPanel"
                    Grid.Row="0"
                    Grid.RowSpan="5"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="Collapsed">

                    <Label x:Name="_downloadProgressLabel" VerticalContentAlignment="Center" />

                    <wpfui:ProgressRing
                        x:Name="_downloadProgressRing"
                        Width="24"
                        Height="24"
                        Margin="4,0,0,0"
                        IsIndeterminate="true"
                        RenderTransformOrigin="0.5,0.5">
                        <wpfui:ProgressRing.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="-90" />
                                <ScaleTransform ScaleX="-1" />
                            </TransformGroup>
                        </wpfui:ProgressRing.RenderTransform>
                    </wpfui:ProgressRing>

                    <wpfui:Button
                        Margin="8,0,0,0"
                        Click="CancelDownloadButton_Click"
                        FontSize="16"
                        Icon="Dismiss24"
                        ToolTip="{x:Static resources:Resource.Cancel}" />

                </StackPanel>

            </Grid>
        </custom:CardControl.Header>
    </custom:CardControl>

</UserControl>
